<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Stub-reference shim (WO-2/WO-3): declares just enough of the Cities:
    Skylines / Unity / ColossalFramework API surface for the compiler to
    resolve every member the mod touches. Nothing here runs; the point is
    to move "inspection-verified" source under a real compiler in CI.
  -->
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <DefineConstants>$(DefineConstants);GAME_STUBS</DefineConstants>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>StubRoot</RootNamespace>
    <NoWarn>0649;0067</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
