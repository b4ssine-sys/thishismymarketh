<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WO-2/WO-3 compile harness: links EVERY mod source file and builds them
    against the stub-reference shim (GameStubs). If the game API surface
    the mod touches changes, this project breaks on CI before a player
    ever sees a crash.

    Gate A acceptance: introduce a deliberately wrong member reference in
    a mod file and verify CI goes red; revert and verify CI goes green.

    This build is a type check only. The DLL it produces references the stub
    assembly and never ships (Directive 01, Gate A); the shipped DLL comes from
    MyFirstMod/MyFirstMod.csproj built against the real game assemblies.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>5</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>MyFirstMod</RootNamespace>
    <OutputType>Library</OutputType>
    <NoWarn>0649;0067;0169;0414</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stubs\GameStubs.csproj" />
  </ItemGroup>

  <!-- Every mod source file, by glob, so a new file can never miss the gate. -->
  <ItemGroup>
    <Compile Include="..\MyFirstMod\**\*.cs" Exclude="..\MyFirstMod\bin\**;..\MyFirstMod\obj\**" LinkBase="Linked" />
  </ItemGroup>

</Project>
